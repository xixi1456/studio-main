,"children":"战队介绍"}],["$","$L8","#groups",{"href":"#groups","className":"text-neutral-500 transition hover:text-white","children":"五大组别"}],["$","$L8","#training",{"href":"#training","className":"text-neutral-500 transition hover:text-white","children":"培养路径"}],["$","$L8","#join",{"href":"#join","className":"text-neutral-500 transition hover:text-white","children":"报名信息"}]]}]]}]}]}],"notFoundStyles":[],"childProp":{"current":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","groups","children"],"loading":"$undefined","loadingStyles":"$undefined","hasLoading":false,"error":"$undefined","errorStyles":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","childProp":{"current":["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","groups","children",["slug","hardware","d"],"children"],"loading":"$undefined","loadingStyles":"$undefined","hasLoading":false,"error":"$undefined","errorStyles":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","childProp":{"current":["$L9",[["$","div",null,{"className":"mx-auto max-w-7xl px-6 lg:px-8 pt-24 sm:pt-32","children":["$","div",null,{"className":"mx-auto w-full max-w-2xl lg:max-w-none","children":["$","$L7",null,{"onMount":true,"className":"","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"font-mono text-xs font-medium tracking-[0.2em] text-accent","children":"02"}],["$","span",null,{"aria-hidden":"true","className":"h-px w-8 bg-accent/50"}],["$","span",null,{"className":"text-xs font-semibold uppercase tracking-[0.22em] text-neutral-400","children":"Hardware"}]]}],["$","h1",null,{"className":"mt-8 max-w-4xl font-display text-4xl font-semibold tracking-tight text-white [text-wrap:balance] sm:text-5xl lg:text-6xl","children":"硬件组 · 组别介绍"}],["$","div",null,{"className":"mt-6 max-w-2xl text-lg text-neutral-400","children":["$","p",null,{"children":"设计并落地主控、接口和嵌入式硬件，让机器人真正能够感知、通信和执行。"}]}]]}]}]}],["$","div",null,{"className":"mx-auto max-w-7xl px-6 lg:px-8 py-20 sm:py-24","children":["$","div",null,{"className":"mx-auto w-full max-w-2xl lg:max-w-none","children":["$","div",null,{"className":"grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16","children":[["$","$L7",null,{"children":["$","article",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"font-mono text-xs uppercase tracking-[0.2em] text-accent","children":["Hardware"," · SPEECH"]}],["$","h2",null,{"className":"mt-5 font-display text-2xl font-semibold text-white","children":["硬件组","演讲稿"]}],["$","div",null,{"className":"mt-8 space-y-6 text-base leading-8 text-neutral-300 sm:text-lg sm:leading-9","children":[["$","p","hardware-speech-0",{"className":"whitespace-pre-line","children":"大家好，我是硬件组组长霍泽朋。"}],["$","p","hardware-speech-1",{"className":"whitespace-pre-line","children":"在整个战队中，硬件组承担着机器人整车供电、电路设计、电路制作与整车布线的核心任务，是机器人能够稳定运行、正常动作的基础保障。简单来说，机械让车有形，电控让车会动，硬件让车有电、稳定、可靠。"}],["$","p","hardware-speech-2",{"className":"whitespace-pre-line","children":"我们硬件组的主要工作内容分为几大部分。"}],["$","p","hardware-speech-3",{"className":"whitespace-pre-line","children":"第一，电路板设计与制作。根据整车各个模块的供电需求，我们使用专业软件绘制PCB电路板，根据不同器件的电压需求、电流需求、功率需求布局线路，保证电路合理、稳定、抗干扰，从电路根源保证整车性能。"}],["$","p","hardware-speech-4",{"className":"whitespace-pre-line","children":"第二，整车供电系统搭建与电压适配。我们整车统一使用24V电池供电，但车上的各个设备电压并不统一。比如视觉小电脑、单片机、传感器、通信模块等设备，都需要5V、3.3V等不同电压。硬件组的核心工作，就是通过降压电路、稳压电路、滤波电路，把24V电压精准转换成各个模块需要的电压，保证每一个设备都能安全、稳定工作。"}],["$","p","hardware-speech-5",{"className":"whitespace-pre-line","children":"第三，功能模块开发制作。除了基础供电板以外，我们还要独立设计、焊接、调试缓启动电路板、超级电容模块、电流采样电路等关键功能板。缓起电路可以防止上电瞬间大电流冲击烧毁器件，超级电容可以在机器人瞬间加速、瞬时大功率输出时补电稳压，提升整车爆发力和稳定性，是比赛中非常关键的硬件保障。"}],["$","p","hardware-speech-6",{"className":"whitespace-pre-line","children":"第四，整车线束焊接与布线规整。整车所有电源线、信号线、控制线，全部由硬件组统一焊接、整理、固定。布线整齐、焊接扎实，能有效避免比赛中出现断线、虚焊、短路、接触不良等致命问题，保证机器人在高强度对抗中稳定运行。"}],["$","p","hardware-speech-7",{"className":"whitespace-pre-line","children":"第五，跨组配合与联调。硬件不是独立工作，我们需要配合机械组的结构开孔、器件安装位置，配合电控组、视觉组的供电需求、信号需求，根据程序和结构的要求调整电路、优化供电、完善模块，让整车软硬件完美匹配。"}],["$","p","hardware-speech-8",{"className":"whitespace-pre-line","children":"最后，我简单说一下硬件学习的心得。硬件是一门非常看重实操的技术。学习硬件不仅需要认识元器件、看懂原理图、理解电路原理，更需要大胆上手、不断焊接、不断调试。学习过程中不怕板子烧坏、不怕出错，每一次烧坏、每一次调试，都是最快速的进步。同时，硬件工作非常考验耐心，焊接、走线、查错、调试都需要细心、沉稳、严谨，只有细节做好，机器人在赛场上才能稳定发挥。"}]]}]]}]}],["$","$L7",null,{"children":["$","aside",null,{"className":"border-t border-white/10 pt-7 lg:sticky lg:top-28","children":[["$","p",null,{"className":"font-mono text-xs uppercase tracking-[0.2em] text-accent","children":"ROLE"}],["$","h2",null,{"className":"mt-5 font-display text-lg font-semibold text-white","children":"组别信息"}],["$","dl",null,{"className":"mt-6 space-y-6","children":[["$","div",null,{"children":[["$","dt",null,{"className":"text-xs uppercase tracking-[0.18em] text-neutral-500","children":"需要什么"}],["$","dd",null,{"className":"mt-2 text-sm leading-relaxed text-neutral-300","children":"愿意学硬件设计、电路分析和嵌入式开发。"}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"text-xs uppercase tracking-[0.18em] text-neutral-500","children":"零基础可以吗"}],["$","dd",null,{"className":"mt-2 text-sm leading-relaxed text-neutral-300","children":"可以。先从小模块和明确任务入手，再逐步接触整板。"}]]}]]}],["$","$L8",null,{"href":"/join","className":"group/btn inline-flex items-center justify-center gap-2 rounded-full font-semibold tracking-tight transition duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 bg-accent text-ink hover:bg-accent-soft focus-visible:outline-accent px-6 py-3 text-sm mt-8","children":[["$","span",null,{"children":"返回报名页面"}],["$","span",null,{"aria-hidden":"true","className":"transition-transform duration-200 group-hover/btn:translate-x-0.5","children":"→"}]]}]]}]}]]}]}]}]],null],"segment":"__PAGE__?{\"slug\":\"hardware\"}"},"styles":[]}],"segment":["slug","hardware","d"]},"styles":[]}],"segment":"groups"},"styles":[]}]}]}]}],null]
